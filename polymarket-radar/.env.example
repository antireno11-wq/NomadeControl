# Copie a .env y ajuste. No guarde secretos reales en el repositorio.
# Este sistema es de solo lectura y simulación: no existen credenciales de trading.

# Contraseña de PostgreSQL usada por docker compose (cámbiela en entornos compartidos).
POSTGRES_PASSWORD=radar
# Puertos publicados en 127.0.0.1 por docker compose.
RADAR_DB_PORT=5433
RADAR_API_PORT=8000
RADAR_DASHBOARD_PORT=8501

# Fuera de Docker (ejecución local), URL de la base:
# RADAR_DATABASE_URL=postgresql+psycopg://radar:radar@localhost:5433/radar

# Único valor admitido. Cualquier otro valor aborta el arranque.
RADAR_TRADING_MODE=paper

# Programación de la ingesta (minutos) y corrida inmediata al iniciar el scheduler.
RADAR_SCHEDULE_INTERVAL_MINUTES=60
RADAR_SCHEDULE_RUN_ON_START=true
# Predicciones cripto en vivo con libros pedidos en el momento (0 = desactivado)
RADAR_PREDICT_INTERVAL_MINUTES=30

# Descubierta: tope de páginas de 100 mercados (vacío = todas). Con tope, la
# corrida queda marcada como incompleta y no se infieren cierres.
# RADAR_GAMMA_MAX_PAGES=

# Ritmo y reintentos frente a las APIs públicas.
RADAR_GAMMA_RATE_PER_S=8
RADAR_CLOB_RATE_PER_S=8
RADAR_CLOB_CONCURRENCY=4
RADAR_HTTP_MAX_RETRIES=5

# Filtro de liquidez sobre el order book ejecutable.
RADAR_LIQ_MAX_SPREAD=0.05
RADAR_LIQ_DEPTH_BAND=0.02
RADAR_LIQ_MIN_DEPTH_USD=100
RADAR_REFERENCE_NOTIONAL_USD=100

# Snapshots: liquid | analyzed ; niveles: all | liquid | none
RADAR_SNAPSHOT_SCOPE=liquid
RADAR_SNAPSHOT_STORE_LEVELS=liquid
RADAR_SNAPSHOT_MAX_LEVELS=50

RADAR_LOG_LEVEL=INFO
