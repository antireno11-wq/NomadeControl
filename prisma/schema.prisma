generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String             @id @default(cuid())
  name                  String
  email                 String             @unique
  passwordHash          String
  role                  String
  isActive              Boolean            @default(true)
  phone                 String?
  profilePhotoUrl       String?
  positionTitle         String?
  emergencyContactName  String?
  emergencyContactPhone String?
  nationalId            String?
  address               String?
  city                  String?
  healthProvider        String?
  shiftPattern          String?
  shiftWorkDays         Int?
  shiftOffDays          Int?
  shiftStartDate        DateTime?
  campId                String?
  camp                  Camp?              @relation(fields: [campId], references: [id], onDelete: SetNull)
  modulePermissions     Json               @default("[]")
  sessions              Session[]
  reports               DailyReport[]
  dailyTaskControls     DailyTaskControl[]
  stockMovements        StockMovement[]
  staffMembers          StaffMember[]
  vehicleChecklists     VehicleChecklist[]
  alertDeliveries       AlertDelivery[]
  auditLogs             AuditLog[]
  incidentesReportados  Incidente[]        @relation("IncidenteReportado")
  incidentesAsignados   Incidente[]        @relation("IncidenteResponsable")
  matricesRiesgo        MatrizRiesgo[]     @relation("MatrizResponsable")
  eppEntregados         EntregaEPP[]       @relation("EPPEntregador")
  cursosCreados         Curso[]            @relation("CursoCreador")
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AlertDelivery {
  id          String   @id @default(cuid())
  kind        String
  targetDate  DateTime
  recipientId String?
  recipient   User?    @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  status      String   @default("SENT")
  payload     String?
  createdAt   DateTime @default(now())

  @@unique([kind, targetDate])
  @@index([targetDate, kind])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorName   String?
  actorEmail  String?
  action      String
  entityType  String
  entityId    String?
  summary     String
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actorUserId, createdAt])
}

model Camp {
  id                         String             @id @default(cuid())
  name                       String
  location                   String?
  latitude                   Float?
  longitude                  Float?
  capacityPeople             Int                @default(0)
  potableWaterTankCapacityM3 Float?
  blackWaterTankCapacityM3   Float?
  greyWaterTankCapacityM3    Float?
  isActive                   Boolean            @default(true)
  closedAt                   DateTime?
  currentShiftSupervisorId   String?
  currentShiftSupervisorName String?
  currentShiftPattern        String?
  currentShiftWorkDays       Int?
  currentShiftOffDays        Int?
  currentShiftStartDate      DateTime?
  users                      User[]
  reports                    DailyReport[]
  dailyTaskControls          DailyTaskControl[]
  stockMovements             StockMovement[]
  inventoryItems             InventoryItem[]
  staffMembers               StaffMember[]
  vehicles                   Vehicle[]
  incidentes                 Incidente[]
  matricesRiesgo             MatrizRiesgo[]
  entregasEPP                EntregaEPP[]
  documentosHSEC             DocumentoHSEC[]
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
}

model Project {
  id        String    @id @default(cuid())
  name      String
  code      String?   @unique
  location  String?
  isActive  Boolean   @default(true)
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, name])
}

model DailyReport {
  id                           String   @id @default(cuid())
  date                         DateTime
  campId                       String
  camp                         Camp     @relation(fields: [campId], references: [id], onDelete: Cascade)
  createdById                  String
  createdBy                    User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  peopleCount                  Int
  breakfastCount               Int
  lunchCount                   Int
  dinnerCount                  Int
  snackSimpleCount             Int
  snackReplacementCount        Int
  waterBottleCount             Int      @default(0)
  lodgingCount                 Int
  meterReading                 Float    @default(0)
  waterLiters                  Int
  fuelLiters                   Int
  fuelRemainingLiters          Int      @default(0)
  generator1Hours              Float    @default(0)
  generator2Hours              Float    @default(0)
  internetStatus               String   @default("FUNCIONANDO")
  blackWaterRemoved            Boolean  @default(false)
  blackWaterRemovedM3          Float    @default(0)
  potableWaterTankLevelPercent Int      @default(0)
  blackWaterTankLevelPercent   Int      @default(0)
  potableWaterDelivered        Boolean  @default(false)
  potableWaterDeliveredM3      Float    @default(0)
  wasteFillPercent             Int      @default(0)
  chlorineLevel                Float    @default(0)
  phLevel                      Float    @default(7)
  extras                       String?
  notes                        String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@unique([campId, date])
}

model DailyTaskControl {
  id                   String   @id @default(cuid())
  date                 DateTime
  campId               String
  camp                 Camp     @relation(fields: [campId], references: [id], onDelete: Cascade)
  createdById          String
  createdBy            User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  administrativeChecks Json
  operationalChecks    Json
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([campId, date])
}

model StockMovement {
  id              String         @id @default(cuid())
  date            DateTime
  campId          String
  camp            Camp           @relation(fields: [campId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  itemName        String
  movementType    String
  quantity        Float
  unit            String         @default("unidad")
  notes           String?
  createdAt       DateTime       @default(now())

  @@index([campId, date])
  @@index([inventoryItemId])
}

model InventoryItem {
  id             String          @id @default(cuid())
  campId         String?
  camp           Camp?           @relation(fields: [campId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  category       String          @default("OTROS")
  unit           String
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockMovements StockMovement[]

  @@unique([campId, normalizedName, unit])
  @@index([campId, isActive, category])
}

model StaffMember {
  id                      String                  @id @default(cuid())
  campId                  String?
  camp                    Camp?                   @relation(fields: [campId], references: [id], onDelete: SetNull)
  createdById             String
  createdBy               User                    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  fullName                String
  role                    String?
  employerCompany         String?
  nationalId              String?
  phone                   String?
  personalEmail           String?
  contractEndDate         DateTime?
  contractIsIndefinite    Boolean                 @default(false)
  altitudeExamDueDate     DateTime?
  occupationalExamDueDate DateTime?
  inductionDueDate        DateTime?
  accreditationDueDate    DateTime?
  driversLicenseDueDate   DateTime?
  cedulaExpiryDate        DateTime?
  foodHandlingExamDueDate DateTime?
  vaccineDueDate          DateTime?
  shiftPattern            String                  @default("14x14")
  shiftWorkDays           Int                     @default(14)
  shiftOffDays            Int                     @default(14)
  shiftStartDate          DateTime
  isActive                Boolean                 @default(true)
  notes                   String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  shiftDays               StaffShiftDay[]
  entregasEPP             EntregaEPP[]
  inducciones             InduccionUsuario[]
  documentos              DocumentoTrabajador[]
  cierre                  CierreContrato?
  documentosAdicionales   DocumentoAdicional[]
  alertasEnviadas         AlertaDocumento[]
  acreditacionDocs        DocumentoAcreditacion[]
  /// Foto del trabajador, para mostrar en la ficha
  fotoArchivoId           String?
  fotoArchivo             ArchivoAcreditacion?    @relation(fields: [fotoArchivoId], references: [id], onDelete: SetNull)

  /// Grupo de cargo, que es lo que decide qué documentos se le exigen.
  /// Distinto de `role`, que es el cargo textual del contrato
  /// ("MONTAJISTA - GASFITER" es role; "Montajista" es el cargo).
  cargoId               String?
  cargo                 Cargo?         @relation(fields: [cargoId], references: [id], onDelete: SetNull)
  /// Proyecto al que está asignado. Define la matriz de requisitos vigente.
  proyectoId            String?
  proyecto              Proyecto?      @relation(fields: [proyectoId], references: [id], onDelete: SetNull)
  calificaciones        Calificacion[]
  /// Por qué dejó de estar activo. Un candidato que nunca firmó y alguien que
  /// trabajó dos años y renunció no son lo mismo, y hasta acá los dos
  /// quedaban simplemente "inactivos".
  motivoBaja            String?
  fechaBaja             DateTime?
  /// Cuadrilla dentro del sistema de turno: "A" o "B".
  cuadrilla             String?
  /// continua | no_continua | por_definir
  continuidad           String?
  /// Trabajó antes en una faena del mandante. Activa el finiquito previo.
  trabajoPrevioMandante Boolean        @default(false)

  @@index([campId, isActive])
  @@index([proyectoId, cargoId])
}

/// Cliente para el que se presta el servicio (Anglo American, Codelco…).
model Mandante {
  id        String     @id @default(cuid())
  nombre    String     @unique
  activo    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  proyectos Proyecto[]
}

/// Contrato concreto con un mandante, en una faena concreta.
/// La matriz de requisitos cuelga de acá: el mismo cargo puede necesitar
/// documentos distintos en dos proyectos del mismo cliente.
model Proyecto {
  id          String   @id @default(cuid())
  mandanteId  String
  mandante    Mandante @relation(fields: [mandanteId], references: [id], onDelete: Cascade)
  nombre      String
  /// mandante | interno
  ///
  /// "mandante" es lo que el cliente exige para dejar entrar a la persona a
  /// su faena. "interno" es lo que NOMADE exige para contratar. Son dos
  /// cumplimientos separados: que falte un papel de contratación no puede
  /// botar la acreditación de un proyecto que no lo pide.
  ambito      String   @default("mandante")
  /// Faena o división donde se ejecuta ("Los Bronces").
  faena       String?
  /// Altura de la faena en metros. Sobre 3.000 se exige el examen de altura
  /// geográfica; se guarda como dato para justificar el requisito.
  altitudMsnm Int?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requisitos   RequisitoDocumento[]
  trabajadores StaffMember[]
  Reunion      Reunion[]
  Compromiso   Compromiso[]
  Amenaza      Amenaza[]

  @@unique([mandanteId, nombre])
}

/// Grupo de cargo de la dotación. Es la unidad sobre la que se definen
/// los requisitos documentales.
model Cargo {
  id        String   @id @default(cuid())
  nombre    String   @unique
  orden     Int      @default(100)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requisitos   RequisitoDocumento[]
  trabajadores StaffMember[]
}

/// Qué documento exige un proyecto a un cargo.
///
/// La ausencia de fila significa "no aplica": no hace falta guardar los
/// no-aplica, que en la planilla original eran ~100 celdas escritas a mano.
/// Calificación de una persona: una habilitación que tiene ADEMÁS de su cargo.
/// Emanuel es montajista (cargo) y además rigger (calificación). No es un
/// cargo nuevo: si lo fuera, habría que duplicar toda la matriz de montajista
/// y crear un cargo más cada vez que alguien saque un carnet.
/// El catálogo lo administra el usuario, no está fijo en el código.
model Calificacion {
  id           String               @id @default(cuid())
  nombre       String               @unique
  descripcion  String?
  activo       Boolean              @default(true)
  orden        Int                  @default(100)
  trabajadores StaffMember[]
  requisitos   RequisitoDocumento[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model RequisitoDocumento {
  id             String        @id @default(cuid())
  proyectoId     String
  proyecto       Proyecto      @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  cargoId        String
  cargo          Cargo         @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  tipoId         String
  tipo           TipoDocumento @relation(fields: [tipoId], references: [id], onDelete: Cascade)
  /// obligatorio | deseable
  nivel          String        @default("obligatorio")
  /// Si viene, el requisito solo aplica a quien tenga esta calificación.
  /// A los demás no se les pide ni les aparece como faltante. Es lo que
  /// distingue una habilitación (rigger) de un cargo (montajista).
  calificacionId String?
  calificacion   Calificacion? @relation(fields: [calificacionId], references: [id], onDelete: Cascade)
  /// Condición del trabajador que activa el requisito. NULL = siempre.
  /// contrato_indefinido | trabajo_previo_mandante | contrato_vencido
  condicion      String?
  /// Requisitos que se cumplen con CUALQUIERA de ellos. El mandante pide
  /// "Examen Ocupacional y de Altura Geográfica" como un solo certificado, y
  /// "Acreditación profesional (o Declaración Jurada de Competencias)" como
  /// una u otra. Sin esto, tener el papel correcto igual dejaba pendiente al
  /// otro tipo del catálogo.
  alternativaDe  String?
  nota           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([proyectoId, cargoId, tipoId])
  @@index([proyectoId, cargoId])
}

/// Catálogo de tipos de documento. Editable desde Administración.
/// `legacyField` mapea al nombre de la columna plana en StaffMember para
/// los 9 tipos que ya existían — permite el backfill y mantener el
/// formulario de ficha funcionando durante la transición.
model TipoDocumento {
  id              String   @id @default(cuid())
  codigo          String   @unique
  nombre          String
  /// Vigencia por defecto cuando el documento no trae vencimiento impreso.
  /// NULL = no vence, o siempre se lee del documento.
  vigenciaDias    Int?
  requiereArchivo Boolean  @default(false)
  /// identidad | previsional | salud_ocupacional | formacion | laboral | seguros
  categoria       String   @default("laboral")
  /// A quién pertenece el documento: trabajador | empresa | vehiculo.
  /// El mandante exige los tres, y mezclarlos haría que a cada persona se le
  /// pidiera el inicio de actividades de la empresa.
  dominio         String   @default("trabajador")
  /// Si aparece como columna en la matriz de control documental.
  /// Con ~24 tipos la matriz sería ilegible; solo los core se muestran.
  mostrarEnMatriz Boolean  @default(false)
  /// Etiqueta corta para el encabezado de columna en la matriz.
  etiquetaCorta   String?
  /// Documento de constancia: prueba que algo se entregó o se firmó, no
  /// caduca (acta de entrega de EPP, recepción del RIOHS, declaración
  /// jurada). Se puede guardar sin fecha de vencimiento.
  noVence         Boolean  @default(false)
  /// Tipo especial: al cargarlo se guarda como foto del trabajador en vez
  /// de como documento con vencimiento.
  esFoto          Boolean  @default(false)
  /// Nombre de la columna equivalente en StaffMember (solo tipos legacy).
  legacyField     String?  @unique
  orden           Int      @default(100)
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  documentos       DocumentoAcreditacion[]
  requisitos       RequisitoDocumento[]
  DocumentoEmpresa DocumentoEmpresa[]

  @@index([activo, orden])
}

/// Archivo binario compartido. Varios documentos extraídos de un mismo PDF
/// apuntan al mismo archivo en vez de duplicar los bytes.
/// En Fase C `contenido` se reemplaza por `url` apuntando a R2/S3.
model ArchivoAcreditacion {
  id               String   @id @default(cuid())
  contenido        Bytes?
  url              String?
  originalFilename String
  mimeType         String
  fileSize         Int?
  /// sha256, para detectar que se subió dos veces el mismo archivo
  hash             String?
  subidoPorNombre  String?
  createdAt        DateTime @default(now())

  documentos         DocumentoAcreditacion[]
  fotoDe             StaffMember[]
  ArchivoDeDocumento ArchivoDeDocumento[]
  DocumentoEmpresa   DocumentoEmpresa[]

  @@index([hash])
}

/// Documento de acreditación. Append-only: cada renovación es una fila nueva.
/// Nunca se hace UPDATE de fechas ni DELETE — para corregir se marca `anulado`.
/// (El modelo `Documento` a secas es el de Biblioteca, sin relación con esto.)
model DocumentoAcreditacion {
  id              String        @id @default(cuid())
  staffMemberId   String
  staffMember     StaffMember   @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  tipoDocumentoId String
  tipoDocumento   TipoDocumento @relation(fields: [tipoDocumentoId], references: [id], onDelete: Restrict)

  fechaEmision         DateTime?
  fechaVencimiento     DateTime?
  /// true = la fecha se infirió (emisión + vigenciaDias). false = venía impresa.
  /// Se muestra distinto en la UI: ante un reclamo del mandante hay que poder
  /// distinguir una fecha leída de una calculada.
  vencimientoCalculado Boolean   @default(false)
  /// Contrato indefinido u otro documento que no vence.
  sinVencimiento       Boolean   @default(false)

  // ── Archivo ──────────────────────────────────────────────────────────
  /// Archivo del que salió este documento. Varios documentos de un mismo
  /// PDF comparten la misma fila de ArchivoAcreditacion.
  archivoId        String?
  archivo          ArchivoAcreditacion? @relation(fields: [archivoId], references: [id], onDelete: SetNull)
  /// Archivos adicionales del MISMO documento: la segunda cara de la cédula,
  /// las páginas de una ficha de ingreso escaneadas de a una. Se agrupan en
  /// un solo documento en vez de crear uno por hoja.
  archivosExtra    ArchivoDeDocumento[]
  /// Legacy: binario suelto de la migración. Los nuevos usan `archivo`.
  contenido        Bytes?
  /// Ruta en R2/S3 una vez migrado.
  archivoUrl       String?
  /// sha256 del archivo, para detectar cargas duplicadas.
  archivoHash      String?
  originalFilename String?
  fileSize         Int?
  mimeType         String?
  /// Página de inicio dentro de un PDF consolidado.
  paginaInicio     Int?

  // ── Trazabilidad ─────────────────────────────────────────────────────
  /// manual | extraido | migracion | excel
  /// Quién contrata, en contratos y anexos. Guardarlo es lo que permite
  /// avisar cuando los papeles de una persona vienen de dos razones sociales.
  empleadorNombre String?
  empleadorRut    String?
  /// Cargo que declara el contrato o anexo. El más nuevo manda.
  cargoContrato   String?

  origen              String    @default("manual")
  /// alta | media | baja — solo cuando origen = extraido
  confianzaExtraccion String?
  confirmadoPorId     String?
  confirmadoPorNombre String?
  confirmadoAt        DateTime?

  anulado          Boolean   @default(false)
  anuladoPorNombre String?
  anuladoAt        DateTime?
  motivoAnulacion  String?

  nota         String?
  /// Clave de origen cuando la fila vino del backfill, para que la
  /// migración sea idempotente. Ej: "staff:<id>:contractEndDate",
  /// "dt:<documentoTrabajadorId>". NULL en documentos creados normalmente.
  migradoDesde String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffMemberId, tipoDocumentoId, fechaVencimiento])
  @@index([anulado, fechaVencimiento])
  @@index([archivoHash])
  @@index([archivoId])
}

// Documento personalizado que HSEC puede agregar sin tocar código
// (ej. "Curso PMSC", "ART renovada", "Anexo confidencialidad")
model DocumentoAdicional {
  id               String      @id @default(cuid())
  staffMemberId    String
  staffMember      StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  nombre           String
  fechaVencimiento DateTime?
  fechaEmision     DateTime?
  notas            String?
  createdById      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([staffMemberId])
  @@index([fechaVencimiento])
}

// Registro de alertas ya enviadas — evita enviar duplicados en el mismo umbral
// para la misma fecha de vencimiento. Cuando el documento se renueva (nueva
// fechaVencimiento), los umbrales se resetean.
model AlertaDocumento {
  id            String      @id @default(cuid())
  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  docType       String // "driversLicenseDueDate", "adicional:<uuid>", etc.
  dueDate       DateTime
  threshold     Int // 30, 15, 7, 0 (día del vencimiento), -1 (vencido hace 1 día), etc.
  sentAt        DateTime    @default(now())
  recipients    String // csv de emails

  @@unique([staffMemberId, docType, dueDate, threshold])
  @@index([sentAt])
}

model StaffShiftDay {
  id            String      @id @default(cuid())
  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  date          DateTime
  status        String
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([staffMemberId, date])
  @@index([date, status])
}

model Vehicle {
  id                      String             @id @default(cuid())
  plate                   String             @unique
  company                 String?
  internalCode            String?
  brand                   String
  model                   String
  year                    Int?
  type                    String
  status                  String             @default("OPERATIVO")
  accreditationStatus     String             @default("PENDIENTE")
  odometerKm              Int                @default(0)
  assignedCampId          String?
  assignedCamp            Camp?              @relation(fields: [assignedCampId], references: [id], onDelete: SetNull)
  assignedProjectId       String?
  assignedProject         Project?           @relation(fields: [assignedProjectId], references: [id], onDelete: SetNull)
  ownerArea               String?
  color                   String?
  vin                     String?
  engineNumber            String?
  circulationPermitDue    DateTime?
  soapDue                 DateTime?
  technicalReviewDue      DateTime?
  insuranceDue            DateTime?
  extinguisherDue         DateTime?
  gpsInstalled            Boolean            @default(false)
  gpsCertificatePresent   Boolean            @default(false)
  unitPhotoSet            Boolean            @default(false)
  winterKitPhotoSet       Boolean            @default(false)
  uvProtectionCertificate Boolean            @default(false)
  reviewedByName          String?
  reviewedAt              DateTime?
  notes                   String?
  documents               VehicleDocument[]
  checklists              VehicleChecklist[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([assignedCampId, status])
  @@index([assignedProjectId, status])
  @@index([plate])
}

model VehicleDocument {
  id           String    @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  documentType String    @default("OTRO")
  name         String
  number       String?
  issuer       String?
  issuedAt     DateTime?
  expiresAt    DateTime
  alertDays    Int       @default(30)
  status       String    @default("VIGENTE")
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([vehicleId, expiresAt])
}

model VehicleChecklist {
  id               String   @id @default(cuid())
  vehicleId        String
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId         String
  driver           User     @relation(fields: [driverId], references: [id], onDelete: Restrict)
  date             DateTime
  odometerKm       Int
  fuelPercent      Int
  frontLightsOk    Boolean  @default(true)
  rearLightsOk     Boolean  @default(true)
  tiresOk          Boolean  @default(true)
  brakesOk         Boolean  @default(true)
  mirrorsOk        Boolean  @default(true)
  hornOk           Boolean  @default(true)
  fluidsOk         Boolean  @default(true)
  jackOk           Boolean  @default(true)
  spareTireOk      Boolean  @default(true)
  extinguisherOk   Boolean  @default(true)
  documentsOk      Boolean  @default(true)
  bodyworkOk       Boolean  @default(true)
  cleanlinessOk    Boolean  @default(true)
  observations     String?
  incidentReported Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([vehicleId, date])
  @@index([driverId, date])
}

model Documento {
