  titulo           String
  descripcion      String?
  categoria        String
  originalFilename String
  fileSize         Int?
  mimeType         String?
  version          String?
  subidoPor        String?
  contenido        Bytes
  createdAt        DateTime @default(now())

  @@index([categoria])
  @@index([createdAt])
}

model ProyectoConfig {
