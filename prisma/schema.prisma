}

model Evaluacion {
  id String @id @default(cuid())

  // Identificación
  evaluadoNombre  String
  evaluadoCargo   String?
  periodo         String
  proyecto        String?
  evaluadorNombre String
  evaluadorId     String?

  // II. Competencias Transversales (1-5)
  planificacion      Int?
  iniciativa         Int?
  cooperacion        Int?
  responsabilidad    Int?
  convivenciaLaboral Int?

  // III. Seguridad y Medio Ambiente (1-5)
  comunicacionSeg Int?
  indumentaria    Int?
  elaboracionDocs Int?
  reportabilidad  Int?
  gestionAmbiente Int?

  // Comentarios por competencia
  comentPlanificacion   String?
  comentIniciativa      String?
  comentCooperacion     String?
  comentResponsabilidad String?
  comentConvivencia     String?
  comentComunicacion    String?
  comentIndumentaria    String?
  comentElaboracion     String?
  comentReportabilidad  String?
  comentGestion         String?

  // Puntaje calculado
  puntajeTotal Float?

  // Retroalimentación
  oportunidadesMejora  String?
  mantenerCargo        String?
  reubicar             String?
  promocion            String?
  reconocimiento       String?
  requiereCapacitacion String?
  observacionesFinales String?

  estado    String   @default("borrador") // borrador | completada
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([evaluadorId])
  @@index([evaluadoNombre])
  @@index([estado, createdAt])
}

// ─── MÓDULO HSEC / PREVENCIÓN ────────────────────────────────────────────────

model Incidente {
  id                  String    @id @default(cuid())
  titulo              String
  descripcion         String
  fechaOcurrencia     DateTime
  lugar               String
  area                String?
  criticidad          String // baja | media | alta | critica
  estado              String    @default("abierto") // abierto | en_investigacion | cerrado
  incumplimientoLegal Boolean   @default(false)
  reportadoPorId      String
  reportadoPor        User      @relation("IncidenteReportado", fields: [reportadoPorId], references: [id])
  responsableId       String?
  responsable         User?     @relation("IncidenteResponsable", fields: [responsableId], references: [id])
  planAccion          String?
  fechaCierre         DateTime?
  evidenciaUrls       Json      @default("[]")
  campId              String?
  camp                Camp?     @relation(fields: [campId], references: [id], onDelete: SetNull)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([estado, createdAt])
  @@index([criticidad])
  @@index([campId])
}

model MatrizRiesgo {
  id             String    @id @default(cuid())
  tarea          String
  area           String
  peligro        String
  probabilidad   Int // 1-5
  impacto        Int // 1-5
  nivelRiesgo    String // bajo | medio | alto | critico
  medidasControl String?
  responsableId  String
  responsable    User      @relation("MatrizResponsable", fields: [responsableId], references: [id])
  evidenciaUrls  Json      @default("[]")
  fechaRevision  DateTime?
  campId         String?
  camp           Camp?     @relation(fields: [campId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([nivelRiesgo])
  @@index([campId])
}

// ─── MÓDULO EPP (dentro de Trabajadores) ─────────────────────────────────────

model TipoEPP {
  id           String       @id @default(cuid())
  nombre       String
  descripcion  String?
  vigenciaDias Int          @default(365)
  isActive     Boolean      @default(true)
  entregas     EntregaEPP[]
  createdAt    DateTime     @default(now())
}

model EntregaEPP {
  id               String       @id @default(cuid())
  staffMemberId    String?
  staffMember      StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)
  nombreTrabajador String
  tipoEppId        String
  tipoEpp          TipoEPP      @relation(fields: [tipoEppId], references: [id])
  cantidad         Int          @default(1)
  fechaEntrega     DateTime
  fechaVencimiento DateTime
  firmaUrl         String?
  entregadoPorId   String
  entregadoPor     User         @relation("EPPEntregador", fields: [entregadoPorId], references: [id])
  campId           String?
  camp             Camp?        @relation(fields: [campId], references: [id], onDelete: SetNull)
  observaciones    String?
  createdAt        DateTime     @default(now())

  @@index([campId, fechaVencimiento])
  @@index([staffMemberId])
}

// ─── MÓDULO INDUCCIONES (dentro de Trabajadores) ─────────────────────────────

model Curso {
  id                String             @id @default(cuid())
  titulo            String
  descripcion       String?
  contenido         String
  tiempoEstimadoMin Int                @default(30)
  activo            Boolean            @default(true)
  createdById       String
  createdBy         User               @relation("CursoCreador", fields: [createdById], references: [id])
  createdAt         DateTime           @default(now())
  preguntas         PreguntaQuiz[]
  inducciones       InduccionUsuario[]

  @@index([activo])
}

model PreguntaQuiz {
  id                String @id @default(cuid())
  cursoId           String
  curso             Curso  @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  pregunta          String
  opciones          Json
  respuestaCorrecta Int
  orden             Int    @default(0)

  @@index([cursoId, orden])
}

model InduccionUsuario {
  id                String       @id @default(cuid())
  staffMemberId     String?
  staffMember       StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)
  nombreTrabajador  String
  cursoId           String
  curso             Curso        @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  estado            String       @default("pendiente") // pendiente | en_progreso | completado | reprobado
  puntaje           Int?
  intentos          Int          @default(0)
  firmaUrl          String?
  certificadoUrl    String?
  reglamentoFirmado Boolean      @default(false)
  fechaInicio       DateTime?
  fechaCompletado   DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([cursoId, estado])
  @@index([staffMemberId])
}

// ─── CIERRE / TÉRMINO DE CONTRATO ────────────────────────────────────────────

/// Registro de baja del trabajador: tipo de término + evaluación de salida interna
model CierreContrato {
  id            String      @id @default(cuid())
  staffMemberId String      @unique
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  /// finiquito | no_renovacion | renuncia | mutuo_acuerdo | otro
  tipo         String
  fechaCierre  DateTime
  motivoCierre String?

  // ── Evaluación de salida ──────────────────────────────────────────────────
  /// excelente | bueno | regular | malo
  desempenoGeneral        String
  /// buena | regular | mala
  puntualidad             String
  /// bueno | regular | malo
  trabajoEnEquipo         String
  /// buena | regular | mala
  calidadTrabajo          String
  /// buena | regular | mala
  actitudSeguridad        String
  /// true = sí lo llamaríamos de vuelta
  recontratarRecomendado  Boolean
  /// inmediata | normal | baja | no_aplica
  prioridadRecontratacion String  @default("normal")
  observaciones           String?
  evaluadoPorNombre       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recontratarRecomendado])
  @@index([fechaCierre])
}

// ─── DOCUMENTOS CON VENCIMIENTO (sistema transversal) ────────────────────────

/// Documentos individuales de cada trabajador (contratos, licencias, exámenes, etc.)
model DocumentoTrabajador {
  id               String      @id @default(cuid())
  staffMemberId    String
  staffMember      StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  /// licencia_conducir | carnet_identidad | contrato | anexo_contrato | examen_preocupacional
  /// examen_periodico | odi_firmada | induccion | capacitacion | credencial | altura_fisica
  /// altura_trabajos | espacios_confinados | antecedentes | liquidacion | finiquito | otro
  tipo             String
  nombre           String
  contenido        Bytes?
  originalFilename String?
  fileSize         Int?
  mimeType         String?
  fechaEmision     DateTime?
  fechaVencimiento DateTime?
  notas            String?
  creadoPorNombre  String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([staffMemberId, fechaVencimiento])
  @@index([tipo])
}

/// Documentos del campamento (autorizaciones, planes, resoluciones, etc.)
model DocumentoHSEC {
  id               String    @id @default(cuid())
  campId           String
  camp             Camp      @relation(fields: [campId], references: [id], onDelete: Cascade)
  /// plan_emergencia | prevencion_riesgos | reglamento_hsec | autorizacion_sanitaria
  /// permiso_edificacion | resolucion_salud | cert_instalaciones | permiso_municipal
  /// contrato_servicio | documento_legal | otro
  tipo             String
  nombre           String
  contenido        Bytes?
  originalFilename String?
  fileSize         Int?
  mimeType         String?
  fechaEmision     DateTime?
  fechaVencimiento DateTime?
  responsable      String?
  notas            String?
  creadoPorNombre  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([campId, fechaVencimiento])
  @@index([tipo])
}

/// Hoja o cara adicional de un documento ya existente.
///
/// Existe porque una cédula llega como dos fotos y una ficha de ingreso como
/// tres hojas sueltas: son un documento, no tres. El archivo principal sigue
/// en `DocumentoAcreditacion.archivoId`; acá van los demás.
model ArchivoDeDocumento {
  id          String                @id @default(cuid())
  documentoId String
  documento   DocumentoAcreditacion @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  archivoId   String
  archivo     ArchivoAcreditacion   @relation(fields: [archivoId], references: [id], onDelete: Cascade)
  /// Orden de presentación: 1 = segunda cara / segunda hoja.
  orden       Int                   @default(1)
  etiqueta    String?
  createdAt   DateTime              @default(now())

  @@unique([documentoId, archivoId])
}

/// Documento de la empresa, no de una persona.
///
/// El mandante exige afiliación al organismo administrador, tasa de
/// accidentabilidad, jornada especial e inicio de actividades en Sernageomin.
/// Son de la razón social y valen para toda la dotación: pedirlos por
/// trabajador sería multiplicar el mismo papel por cada ficha.
model DocumentoEmpresa {
  id              String        @id @default(cuid())
  tipoDocumentoId String
  tipoDocumento   TipoDocumento @relation(fields: [tipoDocumentoId], references: [id], onDelete: Restrict)

  fechaEmision         DateTime?
  fechaVencimiento     DateTime?
  sinVencimiento       Boolean   @default(false)
  vencimientoCalculado Boolean   @default(false)

  archivoId        String?
  archivo          ArchivoAcreditacion? @relation(fields: [archivoId], references: [id], onDelete: SetNull)
  originalFilename String?

  /// Append-only, igual que los del trabajador: renovar es una fila nueva.
  anulado         Boolean  @default(false)
  nota            String?
  subidoPorNombre String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tipoDocumentoId, anulado])
}

// ─── DdD — Diálogo de Desempeño ────────────────────────────────────────
//
// Reemplaza la planilla Excel que es estándar en la minería chilena. La
// pieza central es el compromiso: NO pertenece a una reunión ni a una
// semana, vive hasta que se cierra y va arrastrando su historia de
// reprogramaciones. Esa es la diferencia entre un acta y un sistema de
// gestión.

/// daily | comite_semanal | comite_mensual | bilateral | arranque_contrato | cierre_contrato
model Reunion {
  id                 String    @id @default(cuid())
  tipo               String    @default("daily")
  /// Fecha de la reunión, no de la carga.
  fecha              DateTime
  anio               Int
  /// Semana ISO derivada de `fecha`. Es lo que agrupa el DdD.
  semanaIso          Int
  referencia         String?
  contratoId         String?
  contrato           Proyecto? @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  participantes      String[]
  /// Cruda, tal como se pegó. Se conserva siempre: es la fuente.
  transcripcion      String?
  resumen            String?
  /// borrador | publicada
  estado             String    @default("borrador")
  /// Propuesta de extracción pendiente de revisión, en JSON. Reprocesar la
  /// reemplaza, nunca la duplica.
  propuesta          Json?
  modeloUsado        String?
  creadaPorId        String?
  creadaPorNombre    String?
  publicadaPorNombre String?
  publicadaEn        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  compromisosOrigen Compromiso[]               @relation("CompromisoOrigen")
  compromisosCierre Compromiso[]               @relation("CompromisoCierre")
  amenazasOrigen    Amenaza[]                  @relation("AmenazaOrigen")
  amenazasCierre    Amenaza[]                  @relation("AmenazaCierre")
  rdps              Rdp[]
  gembas            Gemba[]
  reprogramaciones  CompromisoReprogramacion[]

  @@index([anio, semanaIso])
  @@index([estado, fecha])
}

/// Categorías de `oportunidad`. Lista cerrada, editable por Administración.
model CategoriaCompromiso {
  id     String  @id @default(cuid())
  nombre String  @unique
  orden  Int     @default(100)
  activo Boolean @default(true)
}

model Compromiso {
  id              String   @id @default(cuid())
  reunionOrigenId String
  reunionOrigen   Reunion  @relation("CompromisoOrigen", fields: [reunionOrigenId], references: [id], onDelete: Restrict)
  reunionCierreId String?
  reunionCierre   Reunion? @relation("CompromisoCierre", fields: [reunionCierreId], references: [id], onDelete: SetNull)

  /// Nunca se modifica: es la fecha original de captura.
  fechaCaptura  DateTime
  oportunidad   String
  /// Redactada en infinitivo y empezando por el verbo.
  accion        String
  responsable   String
  responsableId String?
  contratoId    String?
  contrato      Proyecto? @relation(fields: [contratoId], references: [id], onDelete: SetNull)

  /// Compromiso original. NUNCA se modifica: reprogramar crea una fila en
  /// CompromisoReprogramacion y actualiza fecha2doCompromiso.
  fechaCierre        DateTime
  fecha2doCompromiso DateTime?
  fechaCierreReal    DateTime?

  /// 0 pendiente, 1 cumplido. Numérico por compatibilidad con el DdD.
  estado               Int     @default(0)
  observacion          String?
  /// Lo marca el extractor cuando el dato no se lee con claridad.
  requiereVerificacion Boolean @default(false)
  /// extraccion | manual
  origen               String  @default("manual")
  evidencia            String?

  cerradoPorNombre String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  reprogramaciones CompromisoReprogramacion[]

  @@index([estado, fechaCierre])
  @@index([responsable])
}

/// Cada movimiento de fecha deja rastro. No se sobrescribe.
///
/// A los tres meses esta tabla es la que muestra quién compromete fechas
/// que no puede cumplir, que es justamente lo que un acta no registra.
model CompromisoReprogramacion {
  id              String     @id @default(cuid())
  compromisoId    String
  compromiso      Compromiso @relation(fields: [compromisoId], references: [id], onDelete: Cascade)
  fechaAnterior   DateTime
  fechaNueva      DateTime
  motivo          String?
  reunionId       String?
  reunion         Reunion?   @relation(fields: [reunionId], references: [id], onDelete: SetNull)
  creadoPorNombre String?
  createdAt       DateTime   @default(now())

  @@index([compromisoId, createdAt])
}

model Amenaza {
  id              String   @id @default(cuid())
  reunionOrigenId String
  reunionOrigen   Reunion  @relation("AmenazaOrigen", fields: [reunionOrigenId], references: [id], onDelete: Restrict)
  reunionCierreId String?
  reunionCierre   Reunion? @relation("AmenazaCierre", fields: [reunionCierreId], references: [id], onDelete: SetNull)

  fechaCaptura         DateTime
  area                 String
  descripcion          String
  responsable          String
  contratoId           String?
  contrato             Proyecto? @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  fechaCierre          DateTime
  fechaCierreReal      DateTime?
  estado               Int       @default(0)
  observacion          String?
  requiereVerificacion Boolean   @default(false)
  evidencia            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([estado, fechaCierre])
}

/// Resolución de Problemas.
///
/// No se cierra cuando se toma la acción: se cierra cuando se verifica que
/// el problema no volvió a ocurrir. Por eso `verificacionEficacia` es
/// condición para poner estado = 1.
model Rdp {
  id                   String   @id @default(cuid())
  reunionOrigenId      String
  reunionOrigen        Reunion  @relation(fields: [reunionOrigenId], references: [id], onDelete: Restrict)
  fechaCaptura         DateTime
  problema             String
  causaRaiz            String?
  accionCorrectiva     String?
  lider                String
  fechaCierre          DateTime
  estado               Int      @default(0)
  verificacionEficacia String?
  evidencia            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Gemba {
  id              String   @id @default(cuid())
  reunionOrigenId String
  reunionOrigen   Reunion  @relation(fields: [reunionOrigenId], references: [id], onDelete: Restrict)
  fechaCaptura    DateTime
  observador      String
  descripcion     String
  area            String?
  lider           String?
  fechaCierre     DateTime
  estado          Int      @default(0)
  evidencia       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// KPI de cumplimiento diario binario: se planifica un día y se cumple o no.
model KpiDefinicion {
  id         String        @id @default(cuid())
  parametro  String
  nombre     String
  activo     Boolean       @default(true)
  contratoId String?
  orden      Int           @default(100)
  registros  KpiRegistro[]

  @@unique([parametro, nombre])
}

model KpiRegistro {
  id              String        @id @default(cuid())
  kpiDefinicionId String
  kpiDefinicion   KpiDefinicion @relation(fields: [kpiDefinicionId], references: [id], onDelete: Cascade)
  fecha           DateTime
  plan            Boolean       @default(false)
  real            Boolean       @default(false)
  contratoId      String?

  @@unique([kpiDefinicionId, fecha])
  @@index([fecha])
}
